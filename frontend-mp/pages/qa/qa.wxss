.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
  padding: 40rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.header-desc {
  font-size: 24rpx;
  opacity: 0.85;
  text-align: center;
  letter-spacing: 2rpx;
}

.login-tip {
  margin: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-card);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}

.login-tip-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex: 1;
}

.login-btn {
  padding: 12rpx 30rpx;
  background: var(--color-primary);
  color: white;
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
}

.question-list {
  padding: 0 var(--spacing-md);
}

.loading, .empty, .loading-more, .no-more {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-text-light);
  font-size: 28rpx;
}

.question-item {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.question-header {
  margin-bottom: 16rpx;
}

.question-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 12rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.question-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-text-light);
}

.question-author {
  margin-right: 20rpx;
}

.question-content {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.question-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-right: 24rpx;
  display: flex;
  align-items: center;
}

.answer-btn {
  padding: 12rpx 30rpx;
  background: var(--color-primary);
  color: white;
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
}

.publish-btn {
  position: fixed;
  bottom: 140rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(139, 69, 19, 0.3);
  z-index: 100;
}

.publish-icon {
  font-size: 44rpx;
  color: white;
  line-height: 1;
  margin-bottom: 4rpx;
}

.publish-text {
  font-size: 20rpx;
  color: white;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 680rpx;
  max-height: 85vh;
  background: var(--color-card);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text);
}

.modal-close {
  font-size: 60rpx;
  color: var(--color-text-light);
  line-height: 1;
  font-weight: 300;
}

.modal-body {
  padding: 32rpx;
  flex: 1;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  box-sizing: border-box;
  background: var(--color-bg);
}

.form-input:focus {
  border-color: var(--color-primary);
  background: white;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
  background: var(--color-bg);
}

.form-textarea:focus {
  border-color: var(--color-primary);
  background: white;
}

.modal-footer {
  display: flex;
  padding: 20rpx 32rpx 32rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  border: none;
  font-weight: 500;
}

.modal-btn.cancel {
  background: var(--color-bg);
  color: var(--color-text-secondary);
}

.modal-btn.confirm {
  background: var(--color-primary);
  color: white;
}

.modal-btn.confirm.disabled {
  background: #CCCCCC;
  color: #999;
}
