.container {
  min-height: 100vh;
  background-color: #FFF8DC;
  padding-bottom: 120rpx;
}

.search-bar {
  padding: 24rpx 24rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.clear-icon {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.category-item.active {
  background-color: #8B4513;
  color: #FFFFFF;
}

.question-list {
  padding: 0 24rpx;
}

.question-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.question-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.question-summary {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.question-tag {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  background-color: rgba(139, 69, 19, 0.1);
  color: #8B4513;
}

.question-meta {
  display: flex;
  align-items: center;
}

.meta-item {
  font-size: 24rpx;
  color: #999999;
  margin-left: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: #999999;
}

.publish-btn {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 69, 19, 0.3);
  z-index: 100;
}

.publish-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

.publish-text {
  font-size: 28rpx;
  font-weight: 500;
}

.login-prompt {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.login-prompt text {
  font-size: 28rpx;
  color: #666666;
}

.login-btn {
  background-color: #8B4513;
  color: #FFFFFF;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  width: 90%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: 36rpx;
  color: #999999;
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.category-select {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-tag {
  padding: 16rpx 24rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s;
}

.category-tag.selected {
  background-color: #8B4513;
  color: #FFFFFF;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.cancel-btn {
  background-color: #F8F8F8;
  color: #666666;
}

.confirm-btn {
  background-color: #8B4513;
  color: #FFFFFF;
}

.confirm-btn.disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
