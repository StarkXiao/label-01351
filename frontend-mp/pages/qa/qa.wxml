<view class="container">
  <view class="header">
    <view class="header-title">文化问答</view>
    <view class="header-desc">探讨乡村文化，分享智慧经验</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="login-tip">
    <view class="login-tip-text">登录后可以发布问题和回答问题</view>
    <button class="login-btn" bindtap="goToLogin">去登录</button>
  </view>

  <view class="question-list">
    <view wx:if="{{loading && questionList.length === 0}}" class="loading">
      <text>加载中...</text>
    </view>

    <view wx:if="{{!loading && questionList.length === 0}}" class="empty">
      <text>暂无问题，快来发布第一个问题吧</text>
    </view>

    <view class="question-item" wx:for="{{questionList}}" wx:key="id">
      <view class="question-header">
        <view class="question-title">{{item.title}}</view>
        <view class="question-meta">
          <text class="question-author">{{item.authorName}}</text>
          <text class="question-time">{{item.createTime}}</text>
        </view>
      </view>
      <view class="question-content">{{item.summary}}</view>
      <view class="question-footer">
        <view class="question-stats">
          <text class="stat-item">💬 {{item.answerCount || 0}} 回答</text>
          <text class="stat-item">👁 {{item.viewCount || 0}} 浏览</text>
        </view>
        <button class="answer-btn" data-id="{{item.id}}" bindtap="showAnswerModal">
          我来回答
        </button>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载更多...</text>
    </view>

    <view wx:if="{{!hasMore && questionList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>

  <view class="publish-btn" bindtap="showPublishModal">
    <text class="publish-icon">+</text>
    <text class="publish-text">发布问题</text>
  </view>

  <view wx:if="{{showPublishModal}}" class="modal-overlay" bindtap="hidePublishModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">发布问题</text>
        <text class="modal-close" bindtap="hidePublishModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <view class="form-label">问题标题</view>
          <input 
            class="form-input" 
            placeholder="请输入问题标题（至少5字）"
            value="{{publishForm.title}}"
            bindinput="onPublishTitleInput"
            maxlength="50"
          />
        </view>
        <view class="form-item">
          <view class="form-label">问题描述</view>
          <textarea 
            class="form-textarea" 
            placeholder="请详细描述你的问题（至少10字）"
            value="{{publishForm.content}}"
            bindinput="onPublishContentInput"
            maxlength="500"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="hidePublishModal">取消</button>
        <button 
          class="modal-btn confirm {{canPublish && !publishing ? '' : 'disabled'}}" 
          bindtap="publishQuestion"
          disabled="{{!canPublish || publishing}}"
        >
          {{publishing ? '发布中...' : '发布'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{showAnswerModal}}" class="modal-overlay" bindtap="hideAnswerModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">回答问题</text>
        <text class="modal-close" bindtap="hideAnswerModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <view class="form-label">你的回答</view>
          <textarea 
            class="form-textarea" 
            placeholder="请输入你的回答（至少5字）"
            value="{{answerContent}}"
            bindinput="onAnswerContentInput"
            maxlength="500"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="hideAnswerModal">取消</button>
        <button 
          class="modal-btn confirm {{canAnswer && !answering ? '' : 'disabled'}}" 
          bindtap="submitAnswer"
          disabled="{{!canAnswer || answering}}"
        >
          {{answering ? '提交中...' : '提交回答'}}
        </button>
      </view>
    </view>
  </view>
</view>
